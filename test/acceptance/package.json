{
  "name": "@verule/acceptance",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "scenarios"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json --pretty false",
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix . --fix",
    "perf": "node --conditions=source scripts/perf.ts",
    "test": "node --conditions=source --test --test-reporter=spec 'test/unit/**/*.test.ts'",
    "test:e2e": "node --test --test-reporter=spec 'test/e2e/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --pretty false"
  },
  "dependencies": {
    "@verule/acceptance-host-app": "workspace:*",
    "@verule/acceptance-host-data": "workspace:*",
    "@verule/acceptance-host-drizzle-zod-app": "workspace:*",
    "@verule/acceptance-host-drizzle-zod-data": "workspace:*",
    "@verule/test-hosts": "workspace:*"
  },
  "devDependencies": {
    "@boringparts/verule": "workspace:*",
    "@tssae/drizzle": "catalog:",
    "@tssae/zod": "catalog:",
    "@types/node": "catalog:",
    "@verule/rules-reference": "workspace:*",
    "@verule/tooling-config": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tssae": "0.1.0",
    "typescript-7": "catalog:"
  },
  "engines": {
    "node": "^26.13.1"
  }
}

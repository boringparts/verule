{
  "extends": ["//"],
  "tags": ["verification"],
  "tasks": {
    "build": {
      "dependsOn": [
        "@verule/adapter-drizzle#build",
        "@verule/adapter-fixture#build",
        "@verule/adapter-fixture-complement#build",
        "@verule/adapter-zod#build",
        "@verule/cli#build",
        "@verule/engine#build",
        "@verule/rules-reference#build",
        "@verule/sdk#build",
        "@verule/test-hosts#build"
      ],
      "inputs": [],
      "outputs": ["dist/**"],
      "cache": false,
      "tags": ["work:preparation"]
    },
    "format:check": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "format:write": {
      "dependsOn": ["lint:fix"],
      "inputs": [],
      "outputs": [],
      "cache": false,
      "tags": ["work:repair"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "lint:fix": {
      "inputs": [],
      "outputs": [],
      "cache": false,
      "tags": ["work:repair"]
    },
    "perf": {
      "dependsOn": ["build"],
      "passThroughEnv": ["INIT_CWD", "VERULE_PERF_CWD"],
      "inputs": [],
      "outputs": [],
      "cache": false,
      "tags": ["work:on-demand"]
    },
    "test": {
      "dependsOn": ["@verule/test-hosts#build", "^typecheck"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "passThroughEnv": [
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "NO_PROXY",
        "http_proxy",
        "https_proxy",
        "no_proxy",
        "XDG_CACHE_HOME"
      ],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "cache": false,
      "tags": ["quality:heavy"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "tags": ["quality:light"]
    }
  }
}

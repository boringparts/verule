{
  "compilerOptions": {
    "strict": true,
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "customConditions": ["source"],
    "types": ["node"],
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "verule.config.ts",
    "verule.native.config.ts",
    "verule.missing-adapter.config.ts",
    "provider-session-overlay/**/*.ts",
    "scenarios/queue/src/**/*.ts",
    "scenarios/queue/verule.config.ts"
  ]
}

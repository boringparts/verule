{
  "name": "@verule/acceptance-host-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/review.ts",
      "types": "./src/review.ts",
      "default": "./src/review.ts"
    },
    "./package.json": "./package.json",
    "./rule": {
      "source": "./src/rule.ts",
      "types": "./src/rule.ts",
      "default": "./src/rule.ts"
    },
    "./host-materials": "./host-materials.json",
    "./host-materials/*": "./*"
  },
  "scripts": {
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@boringparts/verule": "catalog:",
    "@verule/acceptance-host-data": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@verule/rules-reference": "catalog:"
  }
}

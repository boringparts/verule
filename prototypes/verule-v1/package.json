{
  "name": "verule-v1",
  "private": true,
  "type": "module",
  "scripts": {
    "format:check": "oxfmt --list-different --no-error-on-unmatched-pattern *.json pnpm-workspace.yaml pnpm-lock.yaml *.config.ts .gitignore .github scripts",
    "format:write": "oxfmt --write --no-error-on-unmatched-pattern *.json pnpm-workspace.yaml pnpm-lock.yaml *.config.ts .gitignore .github scripts",
    "lint": "oxlint --quiet --format=unix --no-error-on-unmatched-pattern *.config.ts scripts template",
    "lint:fix": "oxlint --format=unix --no-error-on-unmatched-pattern *.config.ts scripts template --fix",
    "typecheck": "tsc --build --noEmit --pretty false",
    "check": "node --conditions=source scripts/task-gates.ts check",
    "check:heavy": "node --conditions=source scripts/task-gates.ts check:heavy",
    "check:full": "node --conditions=source scripts/task-gates.ts check:full",
    "fix": "node --conditions=source scripts/task-gates.ts fix",
    "boundaries": "turbo boundaries"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@verule-v1/tooling-config": "workspace:./packages/tooling-config",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript-7": "catalog:"
  },
  "engines": {
    "node": "26.13.0"
  },
  "packageManager": "pnpm@12.9.1"
}

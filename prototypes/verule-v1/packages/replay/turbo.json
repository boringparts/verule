{
  "extends": ["//"],
  "tags": ["app"],
  "tasks": {
    "format:check": {
      "inputs": [],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "format:write": {
      "dependsOn": ["lint:fix"],
      "inputs": [],
      "outputs": [],
      "cache": false,
      "tags": ["work:repair"]
    },
    "lint": {
      "inputs": [],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "lint:fix": {
      "inputs": [],
      "outputs": [],
      "cache": false,
      "tags": ["work:repair"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "test:replay": {
      "tags": ["quality:heavy"],
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["VERULE_BENCH_REPO", "VERULE_REPLAY_OUTPUT"]
    }
  }
}

{
  "name": "@boringparts/verule",
  "version": "0.1.0",
  "bin": {
    "verule": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json --pretty false",
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix . --fix",
    "postbuild": "node -e \"if (process.platform !== 'win32') require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "test": "node --conditions=source --test --test-reporter=spec 'test/*.test.ts' 'test/unit/**/*.test.ts' 'test/integration/**/*.test.ts'",
    "test:e2e": "node --test --test-reporter=spec test/e2e/cli.test.ts",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --pretty false && node --conditions=source scripts/typecheck-cli-hosts.ts"
  },
  "dependencies": {
    "@verule/engine": "workspace:*",
    "@ykdz/cli-contract": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@verule/test-hosts": "workspace:*",
    "@verule/tooling-config": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsrs": "catalog:",
    "typescript-7": "catalog:"
  },
  "engines": {
    "node": "^26.13.1"
  }
}

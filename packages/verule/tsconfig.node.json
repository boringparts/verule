{
  "extends": "@verule/tooling-config/node.json",
  "compilerOptions": {
    "lib": ["es2024"],
    "skipLibCheck": true,
    "types": ["node"],
    "declarationMap": false
  },
  "include": [
    "scripts/**/*.ts",
    "src/**/*.ts",
    "test/*.ts",
    "test/unit/**/*.ts",
    "test/integration/**/*.ts",
    "test/e2e/**/*.ts",
    "test/helpers/**/*.ts",
    "test/fixtures/type-contract/**/*.ts",
    "*.config.ts"
  ]
}

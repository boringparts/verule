{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true,
    "lib": ["es2024"],
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["../*.ts", "../variants/**/*.ts"]
}

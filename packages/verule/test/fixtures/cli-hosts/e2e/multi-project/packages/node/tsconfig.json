{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "strict": false,
    "strictNullChecks": true,
    "allowJs": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@runtime": ["./src/node.ts"]
    }
  },
  "include": ["src/**/*.ts", "../shared/shared.ts"]
}

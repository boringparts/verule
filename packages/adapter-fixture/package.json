{
  "name": "@verule/adapter-fixture",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./verule-adapter": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./verule-adapter": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix . --fix",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --pretty false",
    "build": "rm -rf dist && tsc -p tsconfig.build.json --pretty false && mkdir -p dist/native && cargo build --locked --release --manifest-path native/Cargo.toml && cp native/target/release/libverule_test_adapter.so dist/native/libverule_test_adapter.so && cargo build --locked --release --features wrong-abi --manifest-path native/Cargo.toml && cp native/target/release/libverule_test_adapter.so native/target/release/libverule_bad_abi.so",
    "test": "node --conditions=source --test --test-reporter=spec 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@verule/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@verule/adapter-api": "workspace:*",
    "@verule/tooling-config": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript-7": "catalog:"
  },
  "engines": {
    "node": "^26.13.1"
  },
  "verule": {
    "native": {
      "linux-x64": "./dist/native/libverule_test_adapter.so"
    }
  }
}

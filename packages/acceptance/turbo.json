{
  "extends": ["//"],
  "tags": ["verification"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [],
      "outputs": ["dist/**"],
      "cache": false,
      "tags": ["work:preparation"]
    },
    "format:check": {
      "inputs": [],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "format:write": {
      "dependsOn": ["lint:fix"],
      "inputs": [],
      "outputs": [],
      "cache": false,
      "tags": ["work:repair"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": [],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "lint:fix": {
      "inputs": [],
      "outputs": [],
      "cache": false,
      "tags": ["work:repair"]
    },
    "test": {
      "dependsOn": [],
      "inputs": [],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "test:e2e": {
      "dependsOn": ["^build", "build"],
      "passThroughEnv": [
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "NO_PROXY",
        "http_proxy",
        "https_proxy",
        "no_proxy",
        "VERULE_HOST_CACHE_DIR",
        "VERULE_VSCODE_REPO",
        "VERULE_VUE_REPO",
        "VERULE_OPENSTATUS_REPO",
        "XDG_CACHE_HOME"
      ],
      "inputs": [],
      "outputs": [],
      "cache": false,
      "tags": ["quality:heavy"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [],
      "outputs": [],
      "tags": ["quality:light"]
    }
  }
}

{
  "name": "@verule/acceptance-host-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/review.ts",
      "types": "./src/review.ts",
      "default": "./src/review.ts"
    },
    "./package.json": "./package.json",
    "./host-root/package.json": "./host-root/package.json",
    "./host-root/*": "./host-root/*"
  },
  "scripts": {
    "format:check": "oxfmt --list-different .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@verule/acceptance-host-data": "workspace:*",
    "@verule/adapter-zod": "0.0.0",
    "@verule/sdk": "catalog:",
    "drizzle-orm": "catalog:",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.0.0"
  },
  "engines": {
    "node": "^26.13.1"
  }
}
